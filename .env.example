# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Appwrite
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_BUCKET_EVIDENCE=

# App
VITE_APP_NAME=SentinelOps
VITE_DEFAULT_LAT=-16.5000
VITE_DEFAULT_LNG=-68.1500

# ========================================================
# VOZ (FastAPI + PyTorch)
# ========================================================
VITE_VOICE_API_URL=

# ========================================================
# N8N — Orquestador de Automatización
# VITE_N8N_ENV: 'test' usa /webhook-test/..., 'prod' usa /webhook/...
# ========================================================
VITE_N8N_BASE_URL=
VITE_N8N_ENV=prod
VITE_N8N_WEBHOOK_ALERTA=alerta-operativa
VITE_N8N_WEBHOOK_CIERRE_RONDA=cierre-ronda-ia

# ========================================================
# API Antifraude — Reloj Blindado (multi-fuente, sin configuración requerida)
# Fuentes internas: Cloudflare CDN → timeapi.io UTC → Date.now()
# Ver: src/utils/timeSync.js
# ========================================================
